{
  "version": 8,
  "name": "Streetmap UK Minimal",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sprite": "https://tiles.openfreemap.org/sprites/ofm_f384/ofm",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#fcfbf7"
      }
    },
    {
      "id": "landuse_park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#d9eec7",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#9ed5ea",
        "fill-outline-color": "#6eaec8"
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "paint": {
        "fill-color": "#eae4db",
        "fill-outline-color": "#cdc5b9"
      }
    },
    {
      "id": "tunnel_casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "==",
        "brunnel",
        "tunnel"
      ],
      "paint": {
        "line-color": "#a0a0a0",
        "line-width": 4,
        "line-dasharray": [
          2,
          2
        ]
      }
    },
    {
      "id": "road_residential_casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        [
          "==",
          "$type",
          "LineString"
        ],
        [
          "in",
          "class",
          "minor",
          "service",
          "residential"
        ]
      ],
      "paint": {
        "line-color": "#9e9e9e",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          1.5,
          16,
          7
        ]
      }
    },
    {
      "id": "road_residential_fill",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        [
          "==",
          "$type",
          "LineString"
        ],
        [
          "in",
          "class",
          "minor",
          "service",
          "residential"
        ]
      ],
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          0.8,
          16,
          5
        ]
      }
    },
    {
      "id": "road_secondary_casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        [
          "==",
          "$type",
          "LineString"
        ],
        [
          "in",
          "class",
          "secondary",
          "tertiary"
        ]
      ],
      "paint": {
        "line-color": "#8c4400",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          2,
          16,
          9
        ]
      }
    },
    {
      "id": "road_secondary_fill",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        [
          "==",
          "$type",
          "LineString"
        ],
        [
          "in",
          "class",
          "secondary",
          "tertiary"
        ]
      ],
      "paint": {
        "line-color": "#f59c1a",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          1.2,
          16,
          7
        ]
      }
    },
    {
      "id": "road_primary_casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        [
          "==",
          "$type",
          "LineString"
        ],
        [
          "in",
          "class",
          "primary",
          "trunk"
        ]
      ],
      "paint": {
        "line-color": "#004d25",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          2,
          16,
          10
        ]
      }
    },
    {
      "id": "road_primary_fill",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        [
          "==",
          "$type",
          "LineString"
        ],
        [
          "in",
          "class",
          "primary",
          "trunk"
        ]
      ],
      "paint": {
        "line-color": "#009a44",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          1.2,
          16,
          8
        ]
      }
    },
    {
      "id": "road_motorway_casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        [
          "==",
          "$type",
          "LineString"
        ],
        [
          "==",
          "class",
          "motorway"
        ]
      ],
      "paint": {
        "line-color": "#003b6d",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          6,
          2.5,
          16,
          12
        ]
      }
    },
    {
      "id": "road_motorway_fill",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        [
          "==",
          "$type",
          "LineString"
        ],
        [
          "==",
          "class",
          "motorway"
        ]
      ],
      "paint": {
        "line-color": "#0079c1",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          6,
          1.5,
          16,
          10
        ]
      }
    },
    {
      "id": "railway_base",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "==",
        "class",
        "rail"
      ],
      "paint": {
        "line-color": "#444444",
        "line-width": 2
      }
    },
    {
      "id": "railway_ticks",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "==",
        "class",
        "rail"
      ],
      "paint": {
        "line-color": "#ffffff",
        "line-width": 1.5,
        "line-dasharray": [
          1.5,
          1.5
        ]
      }
    },
    {
      "id": "ref_motorway_badge",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 6,
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "class"
          ],
          "motorway"
        ],
        [
          "has",
          "ref"
        ]
      ],
      "layout": {
        "icon-image": "shield_uk_motorway",
        "icon-text-fit": "both",
        "icon-text-fit-padding": [
          2,
          5,
          2,
          5
        ],
        "icon-optional": true,
        "text-field": [
          "to-string",
          [
            "get",
            "ref"
          ]
        ],
        "text-font": [
          "Noto Sans Bold"
        ],
        "text-size": 10,
        "symbol-placement": "line",
        "text-rotation-alignment": "viewport",
        "icon-rotation-alignment": "viewport"
      },
      "paint": {
        "text-color": "#ffffff"
      }
    },
    {
      "id": "ref_primary_a_road_badge",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 7,
      "filter": [
        "all",
        [
          "match",
          [
            "get",
            "class"
          ],
          [
            "primary",
            "trunk"
          ],
          true,
          false
        ],
        [
          "has",
          "ref"
        ]
      ],
      "layout": {
        "icon-image": "shield_uk_primary",
        "icon-text-fit": "both",
        "icon-text-fit-padding": [
          2,
          4,
          2,
          4
        ],
        "icon-optional": true,
        "text-field": [
          "to-string",
          [
            "get",
            "ref"
          ]
        ],
        "text-font": [
          "Noto Sans Bold"
        ],
        "text-size": 10,
        "symbol-placement": "line",
        "text-rotation-alignment": "viewport",
        "icon-rotation-alignment": "viewport"
      },
      "paint": {
        "text-color": "#ffd200"
      }
    },
    {
      "id": "motorway_junction_badge",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 10,
      "filter": [
        "all",
        [
          "any",
          [
            "==",
            [
              "get",
              "subclass"
            ],
            "junction"
          ],
          [
            "==",
            [
              "get",
              "class"
            ],
            "motorway_junction"
          ]
        ],
        [
          "has",
          "ref"
        ]
      ],
      "layout": {
        "icon-image": "shield_uk_junction",
        "icon-text-fit": "both",
        "icon-text-fit-padding": [
          2,
          4,
          2,
          4
        ],
        "icon-optional": true,
        "text-field": [
          "to-string",
          [
            "get",
            "ref"
          ]
        ],
        "text-font": [
          "Noto Sans Bold"
        ],
        "text-size": 10,
        "symbol-placement": "point",
        "text-anchor": "center",
        "text-rotation-alignment": "viewport",
        "icon-rotation-alignment": "viewport",
        "icon-allow-overlap": false,
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#ffffff",
        "text-halo-color": "#111111",
        "text-halo-width": 2
      }
    },
    {
      "id": "road_label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "layout": {
        "symbol-placement": "line",
        "text-field": "{name}",
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11,
        "text-letter-spacing": 0.05
      },
      "paint": {
        "text-color": "#1b1b1b",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "place_label_town",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "town",
          "city"
        ],
        true,
        false
      ],
      "layout": {
        "text-field": "{name}",
        "text-font": [
          "Noto Sans Bold"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          12,
          14,
          18
        ],
        "text-transform": "uppercase"
      },
      "paint": {
        "text-color": "#222222",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2
      }
    }
  ]
}